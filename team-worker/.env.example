# Copy to .env only for local deployment; never commit the real file.
TEAM_DOMAIN=https://YOUR-TEAM.cloudflareaccess.com
ACCESS_AUD=YOUR_ACCESS_APPLICATION_AUD
WORKER_NAME=clash-verge-team-api
WORKER_CUSTOM_DOMAIN=https://team-api.YOUR-DOMAIN.example
DEFAULT_TEAM_NAME=Your Team
CACHE_TTL_SECONDS=300
D1_DATABASE_NAME=clash-verge-team
D1_DATABASE_ID=REPLACE_WITH_D1_DATABASE_ID
KV_NAMESPACE_ID=REPLACE_WITH_KV_NAMESPACE_ID
KV_PREVIEW_NAMESPACE_ID=REPLACE_WITH_KV_PREVIEW_NAMESPACE_ID
CLOUDFLARE_ACCOUNT_ID=REPLACE_WITH_CLOUDFLARE_ACCOUNT_ID

# Put this into Wrangler's secret store, not into wrangler.toml:
# UPSTREAM_SUBSCRIPTION_URL=https://YOUR-UPSTREAM.example/subscription

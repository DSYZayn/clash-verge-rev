{
  "name": "clash-verge-team-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "npm run config:prepare && wrangler deploy --config wrangler.generated.toml",
    "config:prepare": "node --env-file-if-exists=.env scripts/prepare-wrangler-config.mjs",
    "typecheck": "tsc --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply TEAM_DB --local",
    "db:migrate:remote": "npm run config:prepare && wrangler d1 migrations apply TEAM_DB --remote --config wrangler.generated.toml"
  },
  "dependencies": {
    "jose": "^6.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260426.1",
    "typescript": "^6.0.0",
    "wrangler": "^4.31.0"
  }
}
